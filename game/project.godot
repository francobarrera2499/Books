; What the Ink Says — Godot 4.7.2 (Forward+). Contrato: docs/ARCHITECTURE.md §2 y §11.
; Autoloads registrados = sólo scripts existentes (stubs válidos). Agregar uno nuevo exige tocar este archivo (dueño: W1-ENG).
config_version=5

[application]

config/name="What the Ink Says"
config/description="Londres, 1894. Un corrector de pruebas compara las crónicas del doctor Watson y, cada mañana, alguien le contesta."
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="fe_de_erratas"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.937, 0.902, 0.824, 1)
boot_splash/show_image=false

[autoload]

ThemeInstaller="*res://autoload/theme_installer.gd"
Data="*res://autoload/data.gd"
Audio="*res://autoload/audio.gd"
Game="*res://autoload/game.gd"

[debug]

file_logging/enable_file_logging=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_multichannel_signed_distance_field=true

