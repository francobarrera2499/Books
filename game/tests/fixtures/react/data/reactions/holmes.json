   "rastro": [
    {
     "tpl": "pared.1",
     "texto": "{{#ancla a:ancla_${ch} a:corresponsal_s|[[@act|«A pique»]]: dele.}} {{#fuente a:remite_journal e:journal_de_geneve|Véase el Journal de Genève del 6 de mayo de 1891.}} —S."
    },
    {
     "tpl": "pared.2",
     "texto": "{{#ancla a:ancla_${ch} a:corresponsal_s|[[@act|Quien fotografía la cascada desde la otra orilla]] ve lo que no ve quien camina el sendero.}} —S."
    },
    {
     "tpl": "cayeron.1",
     "texto": "{{#ancla a:ancla_${ch} a:corresponsal_s|[[@act|«Cayeron los dos»]]: el doctor escribió que no se recuperó a nadie.}} Un corrector no imprime lo que el texto no dice. —S."
    },
    {
     "tpl": "cayeron.2",
     "texto": "{{#ancla a:ancla_${ch} a:corresponsal_s|El Journal tampoco: [[@act|«aucun corps»]].}} —S."
    },
    {
     "tpl": "nota_falsa.1",
     "texto": "{{#ancla a:ancla_${ch} a:corresponsal_s|[[@act|«No sabía»]]: la carta del 4 de mayo dice lo contrario, y el doctor la imprimió entera.}} —S."
    },
    {
     "tpl": "nota_falsa.2",
     "texto": "{{#ancla a:ancla_${ch} a:corresponsal_s|Pregunte en el Englischer Hof [[@act|quién escribió esa nota]].}} —S."
    },
    {
     "tpl": "testamento.1",
     "texto": "{{#ancla a:ancla_${ch} a:corresponsal_s|[[@act|«Sin testamento»]]: el 4 de mayo el difunto dispuso de lo suyo por carta; el doctor la imprimió.}} —S."
    },
    {
     "tpl": "testamento.2",
     "texto": "{{#ancla a:ancla_${ch} a:corresponsal_s|Somerset House cobra un chelín [[@act|por no hallar nada]].}} —S."
    },
    {
     "tpl": "mintio.1",
     "texto": "{{#ancla a:ancla_${ch} a:corresponsal_s|[[@act|«Mintió»]], dice usted.}} Un cronista no es su cajista. —S."
    },
    {
     "tpl": "mintio.2",
     "texto": "{{#ancla a:ancla_${ch} a:corresponsal_s|El «omitir» de la prueba [[@act|no es de la mano del doctor]].}} —S."
    },
    {
     "tpl": "mintio.2.kt",
     "texto": "{{#ancla a:ancla_${ch} a:corresponsal_s|[[@act|«Mintió»]], insiste usted.}} Lea la prueba antes que la revista. —S."
    }
